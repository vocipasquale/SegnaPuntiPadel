<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/score_panel_disabled" />
            <stroke android:width="2dp" android:color="@color/score_led_a" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/score_panel_pressed" />
            <stroke android:width="4dp" android:color="@color/score_led_a" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/score_panel" />
            <stroke android:width="2dp" android:color="@color/score_led_a" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>