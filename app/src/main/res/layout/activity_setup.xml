<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F6">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/setup_title"
                android:textColor="#173D32"
                android:textSize="26sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/team_setup_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/teams_title"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/team_a"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/player_a1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/player_a1"
                            android:inputType="textPersonName"
                            android:maxLines="1" />

                        <EditText
                            android:id="@+id/player_a2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/player_a2"
                            android:inputType="textPersonName"
                            android:maxLines="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/team_b"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/player_b1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/player_b1"
                            android:inputType="textPersonName"
                            android:maxLines="1" />

                        <EditText
                            android:id="@+id/player_b2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/player_b2"
                            android:inputType="textPersonName"
                            android:maxLines="1" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/continue_to_rules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/avanti" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rules_setup_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/match_rules_title"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/sets_to_play"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/sets_to_play"
                    android:inputType="number"
                    android:maxLines="1"
                    android:text="3" />

                <EditText
                    android:id="@+id/max_games_per_set"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/max_games_per_set"
                    android:inputType="number"
                    android:maxLines="1"
                    android:text="10" />

                <EditText
                    android:id="@+id/max_deuce_cycles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/max_deuce_cycles"
                    android:inputType="number"
                    android:maxLines="1"
                    android:text="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/back_to_teams"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="@string/back" />

                    <Button
                        android:id="@+id/start_match"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/start_match" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
