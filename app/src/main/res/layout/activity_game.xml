<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/score_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

<!--        <TextView-->
<!--            android:id="@+id/set_number"-->
<!--            android:layout_width="0dp"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_weight="1"-->
<!--            android:textColor="@color/score_text_muted"-->
<!--            android:textSize="18sp"-->
<!--            android:textStyle="bold" />-->

        <TextView
            android:id="@+id/match_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ScoreboardDigits"
            android:text="00:00"
            android:textColor="@color/score_led_b"
            android:textSize="22sp" />
    </LinearLayout>

<!--    <TextView-->
<!--        android:id="@+id/sets_score"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:gravity="center"-->
<!--        android:paddingTop="4dp"-->
<!--        android:paddingBottom="4dp"-->
<!--        android:textColor="@color/score_text_muted"-->
<!--        android:textSize="16sp"-->
<!--        android:textStyle="bold" />-->

    <TextView
        android:id="@+id/set_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/score_led_b"
        android:textSize="16sp"
        style="@style/ScoreboardDigits" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/score_panel_a"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/team_a_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/score_led_a"
                android:textSize="19sp"
                style="@style/ScoreboardLabel"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/team_a_points"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                style="@style/ScoreboardDigits"
                android:textColor="@color/score_led_a"
                android:textSize="48sp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground" />

<!--            <TextView-->
<!--                android:id="@+id/team_a_games"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:gravity="center"-->
<!--                android:textColor="@color/score_text_muted"-->
<!--                android:textSize="16sp" />-->

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/score_panel_b"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/team_b_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/score_led_b"
                android:textSize="19sp"
                style="@style/ScoreboardLabel"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/team_b_points"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                style="@style/ScoreboardDigits"
                android:textColor="@color/score_led_b"
                android:textSize="48sp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground" />

<!--            <TextView-->
<!--                android:id="@+id/team_b_games"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:gravity="center"-->
<!--                android:textColor="@color/score_text_muted"-->
<!--                android:textSize="16sp" />-->

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
